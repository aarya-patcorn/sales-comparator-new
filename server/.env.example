# ---- Server ----
NODE_ENV=development
# Deployment stage: development | staging | production.
# Supabase Storage is mandatory outside development.
APP_ENV=development

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_comparator

# Bind address
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed browser origins (admin panel, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Express `trust proxy`. Leave false unless behind a proxy: `true` lets clients
# spoof X-Forwarded-For and bypass rate limiting. Behind one load balancer use 1.
TRUST_PROXY=false

# Comma-separated bootstrap admins, seeded by `npm run db:seed` with role=admin.
# Google sign-in only succeeds for an email that already has an active admin row.
ADMIN_ALLOWLIST_EMAILS=

# ---- Sessions ----
# RM session lifetime (days) and admin session lifetime (hours)
SESSION_TTL_DAYS=7
ADMIN_SESSION_TTL_HOURS=12
# node-cron expression for purging expired sessions (default: hourly)
SESSION_CLEANUP_CRON=0 * * * *

# ---- Rate limiting (login + Google sign-in) ----
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Google OAuth (admin login, blueprint §5.2) ----
# The client id is also exposed to the admin SPA as VITE_GOOGLE_CLIENT_ID.
# The secret is server-side only — never ship it to a browser, and NEVER put a
# real value in this file: .env.example is committed. Put real values in .env.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- OpenAI (TDS extraction, blueprint §3a) ----
# Optional: without it, /api/admin/tds/extract returns 503 and admins enter
# specifications manually. Everything else keeps working.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Supabase Storage (uploaded TDS documents) ----
# Supabase is used for the storage BUCKET ONLY; the database uses the single
# managed Postgres connection string in DATABASE_URL above.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are REQUIRED when APP_ENV is
# staging or production. In development they may be left blank, and uploads
# fall back to a local ./uploads directory.
SUPABASE_URL=https://your-project.supabase.co
# SECRET - server-side only. It bypasses row-level security, so it must never
# reach the admin panel or the mobile app, and never be committed here.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tds-files
# Lifetime of on-demand signed download URLs, in seconds.
SUPABASE_SIGNED_URL_TTL=3600

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
