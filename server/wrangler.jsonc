{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamdhenu-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "vars": {
    "NODE_ENV": "production",
    "APP_ENV": "production",
    "PORT": "8787",
    "HOST": "0.0.0.0",
    "CORS_ORIGINS": "",
    "SESSION_TTL_DAYS": "7",
    "ADMIN_SESSION_TTL_HOURS": "12",
    "SESSION_CLEANUP_CRON": "0 * * * *",
    "AUTH_RATE_LIMIT_WINDOW_MS": "900000",
    "AUTH_RATE_LIMIT_MAX": "20",
    "TRUST_PROXY": "1",
    "OPENAI_MODEL": "gpt-4o-mini",
    "SUPABASE_STORAGE_BUCKET": "tds-files",
    "SUPABASE_SIGNED_URL_TTL": "3600",
    "LOG_LEVEL": "info"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
